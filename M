/* Chỉnh chữ trong bài dịch cho đẹp */
.flashcard.translate-card .vn-text {
    font-size: 1.2rem;
    margin-bottom: 10px;
    display: block;
    border-bottom: 1px dashed #ccc;
    padding-bottom: 10px;
}
        
