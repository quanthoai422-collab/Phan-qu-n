        // --- BÀI 11: THỜI TIẾT ---
        { id: 11001, lesson: "Bài 11", type: "grammar", vn: "Bất quy tắc của phụ âm 'ㅂ'", kr: "ㅂ 불규칙", note: "Chữ bé: 'ㅂ' gặp nguyên âm đổi thành '우'. Ví dụ: 춥다 -> 추워요, 덥다 -> 더워요. (Ngoại lệ: 돕다, 곱다 đổi thành '오' khi gặp -아/어)." },
        { id: 11002, lesson: "Bài 11", type: "grammar", vn: "Vì... nên... (Nguyên nhân, trình tự)", kr: "V/A-아/어/여서", note: "Không dùng đuôi mệnh lệnh hoặc rủ rê sau cấu trúc này. Ví dụ: 비가 와서 우산이 필요해요." },
        { id: 11003, lesson: "Bài 11", type: "grammar", vn: "So sánh (Hơn...)", kr: "N보다", note: "N보다 + Tính từ. Ví dụ: 오늘은 어제보다 더워요 (Hôm nay nóng hơn hôm qua)." },

        // --- BÀI 12: ĐIỆN THOẠI ---
        { id: 12001, lesson: "Bài 12", type: "grammar", vn: "Thử làm việc gì đó", kr: "V-아/어/여 보다", note: "Ví dụ: 한국 음식을 먹어 봤어요 (Tôi đã ăn thử món Hàn)." },
        { id: 12002, lesson: "Bài 12", type: "grammar", vn: "Đuôi câu hứa hẹn (Sẽ làm...)", kr: "V-(으)ㄹ게요", note: "Chỉ dùng cho ngôi thứ nhất (Tôi). Ví dụ: 제가 전화할게요 (Tôi sẽ gọi điện nhé)." },
        { id: 12003, lesson: "Bài 12", type: "grammar", vn: "Đang làm gì đó", kr: "V-고 있다", note: "Thì hiện tại tiếp diễn. Ví dụ: 친구하고 통화하고 있어요 (Đang nói chuyện điện thoại với bạn)." },

        // --- BÀI 13: SINH NHẬT / KẾ HOẠCH ---
        { id: 13001, lesson: "Bài 13", type: "grammar", vn: "Định làm gì đó", kr: "V-(으)려고 하다", note: "Diễn tả ý định. Có patchim dùng -으려고 하다. Ví dụ: 친구를 만나려고 해요." },
        { id: 13002, lesson: "Bài 13", type: "grammar", vn: "Nếu... thì...", kr: "V/A-(으)면", note: "Giả định. Chữ bé: Với gốc từ có 'ㄹ' thì chỉ cần cộng -면. Ví dụ: 비가 오면 집에서 쉴 거예요." },
        { id: 13003, lesson: "Bài 13", type: "grammar", vn: "Phải làm gì đó", kr: "V/A-아/어/여야 하다", note: "Sự bắt buộc. Ví dụ: 숙제를 해야 해요 (Phải làm bài tập)." },

        // --- BÀI 14: SỞ THÍCH ---
        { id: 14001, lesson: "Bài 14", type: "grammar", vn: "Có thể / Không thể làm gì", kr: "V-(으)ㄹ 수 있다/없다", note: "Chỉ khả năng. Ví dụ: 한국어를 할 수 있어요 (Tôi có thể nói tiếng Hàn)." },
        { id: 14002, lesson: "Bài 14", type: "grammar", vn: "Danh từ hóa động từ (Việc làm...)", kr: "V-기", note: "Ví dụ: 제 취미는 사진 찍기입니다 (Sở thích của tôi là việc chụp ảnh)." },
        { id: 14003, lesson: "Bài 14", type: "grammar", vn: "Trong khi / Vừa... vừa...", kr: "V-(으)면서", note: "Hai hành động xảy ra cùng lúc. Ví dụ: 음악을 들으면서 공부해요." },

        // --- BÀI 15: GIAO THÔNG ---
        { id: 15001, lesson: "Bài 15", type: "grammar", vn: "Từ... Đến... (Địa điểm)", kr: "N에서 N까지", note: "Phân biệt với 부터-까지 (thời gian). Ví dụ: 학교에서 집까지 얼마나 걸려요?" },
        { id: 15002, lesson: "Bài 15", type: "grammar", vn: "Bằng phương tiện / Hướng đi", kr: "N-(으)로", note: "Chữ bé: Nếu danh từ kết thúc bằng 'ㄹ' thì chỉ cộng -로. Ví dụ: 지하철로 가요 (Đi bằng tàu điện ngầm)." },
        { id: 15003, lesson: "Bài 15", type: "grammar", vn: "Mất bao lâu (thời gian)", kr: "시간이 걸리다", note: "Ví dụ: 30분 걸려요 (Mất 30 phút)." },
        { id: 15004, lesson: "Bài 15", type: "grammar", vn: "Đuôi câu cảm thán", kr: "V/A-네요", note: "Diễn tả sự ngạc nhiên. Ví dụ: 한국말을 참 잘하시네요! (Bạn nói tiếng Hàn giỏi thế!)" },
// =========================================================
        // 📚 TỔNG HỢP 100% NGỮ PHÁP BÀI 1 ĐẾN BÀI 5 (DỄ HIỂU + VÍ DỤ)
        // =========================================================

        // --- BÀI 1: GIỚI THIỆU ---
        { id: 20101, lesson: "Bài 1", type: "grammar", vn: "Là... (Khẳng định)", kr: "N 입니다", note: "Gắn sau danh từ. Ví dụ: 저는 학생입니다 (Tôi là học sinh)." },
        { id: 20102, lesson: "Bài 1", type: "grammar", vn: "Là... phải không? (Nghi vấn)", kr: "N 입니까?", note: "Dùng để hỏi. Ví dụ: 회사원입니까? (Bạn là nhân viên công ty phải không?)" },
        { id: 20103, lesson: "Bài 1", type: "grammar", vn: "Tiểu từ chủ đề", kr: "N 은/는", note: "Có patchim + 은, không patchim + 는. Ví dụ: 이름은 무엇입니까? (Tên bạn là gì?)" },
        { id: 20104, lesson: "Bài 1", type: "grammar", vn: "Cách xưng hô lịch sự", kr: "Tên + 씨", note: "Dùng gọi người khác lịch sự. Ví dụ: 화 씨 (Bạn Hoa). Lưu ý: Không dùng sau Họ đơn độc." },

        // --- BÀI 2: TRƯỜNG HỌC ---
        { id: 20201, lesson: "Bài 2", type: "grammar", vn: "Tiểu từ chủ ngữ", kr: "N 이/가", note: "Có patchim + 이, không patchim + 가. Ví dụ: 교실이 큽니다 (Phòng học to)." },
        { id: 20202, lesson: "Bài 2", type: "grammar", vn: "Có / Không có cái gì", kr: "N 이/가 있다/없다", note: "Ví dụ: 시계가 있습니다 (Có đồng hồ). 사전이 없습니다 (Không có từ điển)." },
        { id: 20203, lesson: "Bài 2", type: "grammar", vn: "Tiểu từ vị trí (Ở...)", kr: "N(Địa điểm) 에", note: "Chỉ nơi tồn tại. Ví dụ: 학교에 있습니다 (Có ở trường học)." },
        { id: 20204, lesson: "Bài 2", type: "grammar", vn: "Đại từ chỉ vật (Cái này/đó/kia)", kr: "이것/그것/저것", note: "Chỉ vật gần người nói/gần người nghe/xa cả hai. Ví dụ: 이것은 책입니다." },
        { id: 20205, lesson: "Bài 2", type: "grammar", vn: "Không phải là...", kr: "N 이/가 아니다", note: "Chia trang trọng: 아닙니다. Ví dụ: 학생이 아닙니다 (Không phải là học sinh)." },

        // --- BÀI 3: SINH HOẠT HÀNG NGÀY ---
        { id: 20301, lesson: "Bài 3", type: "grammar", vn: "Đuôi câu trang trọng (Khẳng định)", kr: "V/A 습니다/ㅂ니다", note: "Có patchim + 습니다, không patchim + ㅂ니다. Ví dụ: 먹습니다 (Ăn), 갑니다 (Đi)." },
        { id: 20302, lesson: "Bài 3", type: "grammar", vn: "Đuôi câu trang trọng (Nghi vấn)", kr: "V/A 습니까/ㅂ니까?", note: "Ví dụ: 공부합니까? (Có học không?)." },
        { id: 20303, lesson: "Bài 3", type: "grammar", vn: "Tiểu từ tân ngữ", kr: "N 을/를", note: "Chỉ đối tượng của hành động. Có patchim + 을, không patchim + 를. Ví dụ: 빵을 먹습니다." },
        { id: 20304, lesson: "Bài 3", type: "grammar", vn: "Tại/Ở (Địa điểm hành động)", kr: "N(Địa điểm) 에서", note: "Nơi diễn ra hành động. Ví dụ: 집에서 쉽니다 (Nghỉ ở nhà)." },
        { id: 30305, lesson: "Bài 3", type: "grammar", vn: "Phủ định (Không...)", kr: "안 + V/A", note: "Ví dụ: 안 가요 (Không đi). Với động từ 'N 하다' thì dùng 'N 안 하다' (Ví dụ: 운동 안 해요)." },

        // --- BÀI 4: NGÀY VÀ THỨ ---
        { id: 20401, lesson: "Bài 4", type: "grammar", vn: "Số Hán Hàn (Đếm ngày/tháng/năm)", kr: "일, 이, 삼, 사...", note: "Lưu ý chữ bé: Tháng 6 là 유월, tháng 10 là 시월 (bỏ patchim)." },
        { id: 20402, lesson: "Bài 4", type: "grammar", vn: "Tiểu từ thời gian (Vào lúc...)", kr: "N(Thời gian) 에", note: "Ví dụ: 10월 5일에 만나요. Lưu ý: Không dùng '에' sau 어제, 오늘, 내일." },
        { id: 20403, lesson: "Bài 4", type: "grammar", vn: "Cũng...", kr: "N 도", note: "Thay thế cho 은/는, 이/가. Ví dụ: 저도 베트남 사람입니다 (Tôi cũng là người VN)." },
        { id: 20404, lesson: "Bài 4", type: "grammar", vn: "Từ... Đến... (Thời gian)", kr: "N 부터 N 까지", note: "Ví dụ: 8시부터 12시까지 (Từ 8 giờ đến 12 giờ)." },

        // --- BÀI 5: CÔNG VIỆC TRONG NGÀY ---
        { id: 20501, lesson: "Bài 5", type: "grammar", vn: "Số Thuần Hàn (Đếm giờ/tuổi/vật)", kr: "하나, 둘, 셋, 넷...", note: "Lưu ý chữ bé: 1,2,3,4,20 đổi thành 한, 두, 세, 네, 스무 khi đứng trước đơn vị đếm." },
        { id: 20502, lesson: "Bài 5", type: "grammar", vn: "Đọc Giờ - Phút", kr: "Số Thuần Hàn 시 - Số Hán Hàn 분", note: "Ví dụ: 2시 30분 (두 시 삼십 분)." },
        { id: 20503, lesson: "Bài 5", type: "grammar", vn: "Đuôi câu thân mật (-아요/어요/해요)", kr: "V/A 아/어/해요", note: "Kết thúc là '아/오' + 아요; khác '아/오' + 어요; '하다' -> 해요. Ví dụ: 가다->가요, 먹다->먹어요." },
        { id: 20504, lesson: "Bài 5", type: "grammar", vn: "Là... (Thân mật)", kr: "N 이에요/예요", note: "Có patchim + 이에요, không patchim + 예요. Ví dụ: 학생이에요, 의사예요." },
// =========================================================
        // 📚 NGỮ PHÁP BÀI 6 ĐẾN BÀI 10 (ĐẦY ĐỦ 100% + LƯU Ý CHỮ BÉ)
        // =========================================================

        // --- BÀI 6: CUỐI TUẦN ---
        { id: 60001, lesson: "Bài 6", type: "grammar", vn: "Đuôi câu rủ rê, gợi ý (Chúng ta cùng... nhé?)", kr: "V-(으)ㄹ까요?", note: "Có patchim dùng -을까요?, không patchim dùng -ㄹ까요?. Ví dụ: 같이 갈까요? (Cùng đi nhé?)" },
        { id: 60002, lesson: "Bài 6", type: "grammar", vn: "Đuôi câu tương lai, dự định (Sẽ...)", kr: "V/A-(으)ㄹ 거예요", note: "Chữ bé: Ngoài nghĩa tương lai, còn dùng để dự đoán. Với patchim 'ㄹ' thì chỉ cần + 거예요 (Ví dụ: 만들 거예요)." },
        { id: 60003, lesson: "Bài 6", type: "grammar", vn: "Bất quy tắc của phụ âm 'ㄹ'", kr: "ㄹ 탈락", note: "Chữ bé: Khi gốc động từ kết thúc bằng 'ㄹ' gặp 'ㄴ, ㅂ, ㅅ' thì 'ㄹ' sẽ biến mất. Ví dụ: 살다 + 습니다 -> 삽니다." },

        // --- BÀI 7: MUA SẮM ---
        { id: 70001, lesson: "Bài 7", type: "grammar", vn: "Yêu cầu, mệnh lệnh lịch sự (Hãy...)", kr: "V-(으)세요", note: "Có patchim dùng -으세요, không patchim dùng -세요. Ví dụ: 앉으세요 (Hãy ngồi xuống)." },
        { id: 70002, lesson: "Bài 7", type: "grammar", vn: "Làm gì đó cho ai đó", kr: "V-아/어 주다", note: "Kết hợp quy tắc chia đuôi 아/어. Ví dụ: 사 주세요 (Hãy mua cho tôi)." },
        { id: 70003, lesson: "Bài 7", type: "grammar", vn: "Số thuần Hàn + Đơn vị đếm", kr: "Số đếm", note: "Chữ bé: Phải đổi 1,2,3,4,20 thành 한, 두, 세, 네, 스무 khi có đơn vị đếm phía sau (Ví dụ: 한 명, 두 개)." },

        // --- BÀI 8: THỨC ĂN ---
        { id: 80001, lesson: "Bài 8", type: "grammar", vn: "Mong muốn (Muốn...)", kr: "V-고 싶다", note: "Chữ bé: Chỉ dùng cho ngôi thứ 1 và 2. Với ngôi thứ 3 phải dùng V-고 싶어 하다." },
        { id: 80002, lesson: "Bài 8", type: "grammar", vn: "Đuôi câu phủ định (Không...)", kr: "A/V-지 않다", note: "Dùng sau gốc từ. Ví dụ: 맵지 않습니다 (Không cay). Tương đương với việc thêm '안' phía trước." },
        { id: 80003, lesson: "Bài 8", type: "grammar", vn: "Cấu trúc 'Đừng làm gì đó'", kr: "V-지 말다", note: "Chia mệnh lệnh lịch sự thành -지 마세요. Ví dụ: 사지 마세요 (Đừng mua)." },

        // --- BÀI 9: NHÀ CỬA ---
        { id: 90001, lesson: "Bài 9", type: "grammar", vn: "Mệnh lệnh trang trọng (Hãy...)", kr: "V-(으)십시오", note: "Dùng trong tình huống cực kỳ trang trọng. Có patchim -하십시오, không patchim -십시오." },
        { id: 90002, lesson: "Bài 9", type: "grammar", vn: "Chỉ hướng hoặc phương tiện (Bằng..., hướng...)", kr: "N-(으)로", note: "Có patchim dùng -으로, không patchim (hoặc patchim là 'ㄹ') dùng -로. Ví dụ: 부산으로 (Hướng về Busan), 버스로 (Bằng xe buýt)." },
        { id: 90003, lesson: "Bài 9", type: "grammar", vn: "Phủ định của danh từ (Không phải là...)", kr: "N이/가 아니다", note: "Dùng 이 khi có patchim, 가 khi không có. Ví dụ: 학생이 아니에요." },

        // --- BÀI 10: GIA ĐÌNH & KÍNH NGỮ ---
        { id: 100001, lesson: "Bài 10", type: "grammar", vn: "Kính ngữ của chủ thể (Vị... làm gì đó)", kr: "V/A-(으)시-", note: "Chữ bé: Gắn vào gốc từ để tôn kính người thực hiện hành động. Ví dụ: 가다 -> 가십니다." },
        { id: 100002, lesson: "Bài 10", type: "grammar", vn: "Tiểu từ chủ ngữ tôn kính", kr: "N께서", note: "Thay thế cho 이/가 khi chủ ngữ là người bề trên (Ông bà, thầy cô...)." },
        { id: 100003, lesson: "Bài 10", type: "grammar", vn: "Tiểu từ 'Cho/Tặng' tôn kính", kr: "N께", note: "Thay thế cho 에게/한테. Ví dụ: 선생님께 드립니다 (Gửi tặng thầy giáo)." },
        { id: 100004, lesson: "Bài 10", type: "grammar", vn: "Lưu ý chữ bé về từ 'Có'", kr: "있으시다 vs 계시다", note: "계시다 dùng khi nói người bề trên đang ở đâu đó. 있으시다 dùng khi nói người bề trên sở hữu cái gì đó (Ví dụ: Thầy có điện thoại - 있으시다)." },
        { id: 100005, lesson: "Bài 10", type: "grammar", vn: "Bất quy tắc của phụ âm 'ㄷ'", kr: "ㄷ 불규칙", note: "Chữ bé: 'ㄷ' gặp nguyên âm đổi thành 'ㄹ'. Ví dụ: 듣다 (nghe) -> 들어요. (Ngoại lệ: 닫다, 받다, 믿다 không đổi)." },

