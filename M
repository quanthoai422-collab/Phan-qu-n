// ==========================================
// 1. KHỞI TẠO BỘ NHỚ VÀ TRẠNG THÁI
// ==========================================
var starredCards = JSON.parse(localStorage.getItem('myStarredCards')) || [];
var isQuiz = false;
var currentCat = 'All';
var currentLes = 'All';

// ==========================================
// 2. HÀM HIỂN THỊ THẺ (FLASHCARD & QUIZ)
// ==========================================
// ==========================================
    // HÀM HIỂN THỊ THẺ (Sửa lỗi lộ đáp án Luyện gõ)
    // ==========================================
    function renderCards(cards) {
        const container = document.getElementById('card-container');
        if (!container) return;
        container.innerHTML = '';
        
        cards.forEach(card => {
            const div = document.createElement('div');
            div.className = 'flashcard' + ((card.type === 'translate' || card.type === 'practice') ? ' translate-card' : '');
            
            let safeKr = (card.kr || '').replace(/'/g, "\\'");
            let isStarred = starredCards.includes(card.id);
            
            // Nút Ngôi sao
            let starHTML = `<div class="star-btn ${isStarred ? 'active' : ''}" onclick="toggleStar(${card.id}, event)">★</div>`;
            
            // Nút Loa
            let speakerHTML = `<span class="speaker-btn" title="Nghe phát âm" onclick="speakKorean('${safeKr}', event)" style="cursor:pointer; font-size:1.4rem; margin-left:10px; display:inline-block; vertical-align:middle;">🔊</span>`;

            if (isQuiz) {
                // CHẾ ĐỘ LUYỆN GÕ
                // 1. Loa nằm cạnh Tiếng Việt để nghe trước khi gõ
                // 2. Đáp án Tiếng Hàn bị ÉP ẨN ĐI (style="display:none;")
                div.innerHTML = starHTML + `
                    <div class="vn-text" style="margin-bottom: 15px; display: flex; justify-content: center; align-items: center; font-weight: 600;">
                        ${card.vn || ''} ${speakerHTML}
                    </div>
                    <input type="text" class="quiz-input" placeholder="Gõ tiếng Hàn..." onkeyup="checkInlineAnswer(this, event, '${safeKr}')">
                    <div class="kr-result-container" style="display:none; margin-top:15px; text-align:center;">
                        <span style="font-size:1.6rem; color:#d35400; font-weight:bold;">${card.kr}</span>
                    </div>
                `;
            } else {
                // CHẾ ĐỘ XEM THẺ (FLASHCARD)
                div.onclick = function() {
                    const res = this.querySelector('.kr-result-container');
                    if (res) res.style.display = (res.style.display === 'block' ? 'none' : 'block');
                };
                div.innerHTML = starHTML + `
                    <div class="vn-text" style="font-weight: 600;">${card.vn || ''}</div>
                    <div class="kr-result-container" style="display:none; margin-top:15px; text-align:center;">
                        <span style="font-size:1.6rem; color:#d35400; font-weight:bold;">${card.kr}</span> ${speakerHTML}
                    </div>
                    <div style="font-size:0.85rem; color:#888; margin-top:8px;">${card.note || ''}</div>
                `;
            }
            container.appendChild(div);
        });
    }

// ==========================================
// 3. XỬ LÝ LƯU NGÔI SAO (VĨNH VIỄN)
// ==========================================
function toggleStar(cardId, event) {
    event.stopPropagation(); // Ngăn lật thẻ
    let index = starredCards.indexOf(cardId);
    
    if (index === -1) {
        starredCards.push(cardId);
        event.target.classList.add('active');
    } else {
        starredCards.splice(index, 1);
        event.target.classList.remove('active');
        // Nếu đang ở tab Từ khó thì ẩn thẻ ngay
        if (currentCat === 'starred') filterCards();
    }
    
    // Lưu vào trình duyệt (LocalStorage)
    localStorage.setItem('myStarredCards', JSON.stringify(starredCards));
}

// ==========================================
// 4. PHÁT ÂM VÀ KIỂM TRA ĐÁP ÁN
// ==========================================
function speakKorean(text, event) {
    if(event) event.stopPropagation();
    if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        var utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'ko-KR';
        utterance.rate = 0.9;
        window.speechSynthesis.speak(utterance);
    }
}

function checkInlineAnswer(inputElement, event, correctAnswer) {
    let userVal = inputElement.value.trim().toLowerCase().replace(/[\s.,?!~()]/g, '');
    let correctVal = correctAnswer.trim().toLowerCase().replace(/[\s.,?!~()]/g, '');
    let resultBox = inputElement.parentElement.querySelector('.kr-result-container');
    
    inputElement.classList.remove('quiz-correct', 'quiz-wrong');
    
    if (userVal === '') {
        if(resultBox) resultBox.style.display = 'none';
        return;
    }
    
    if (userVal === correctVal) {
        inputElement.classList.add('quiz-correct');
        if(resultBox) resultBox.style.display = 'block';
        speakKorean(correctAnswer); 
    } else if (event.key === 'Enter') {
        inputElement.classList.add('quiz-wrong');
        if(resultBox) resultBox.style.display = 'block';
    }
}

// ==========================================
// 5. LỌC DỮ LIỆU CHUẨN
// ==========================================
function filterCards() {
    var searchInput = document.getElementById('searchInput');
    var keyword = searchInput ? searchInput.value.toLowerCase().trim() : '';
    
    var filtered = data.filter(i => {
        // Lọc theo mục (có mục starred)
        let passCat = false;
        if (currentCat === 'All') passCat = true;
        else if (currentCat === 'starred') passCat = starredCards.includes(i.id);
        else passCat = (i.type === currentCat);

        // Lọc theo bài học
        let passLes = (currentLes === 'All') ? true : (i.lesson === currentLes);

        // Lọc theo tìm kiếm
        let passKey = (keyword === '') ? true : 
                     (i.vn?.toLowerCase().includes(keyword) || i.kr?.toLowerCase().includes(keyword));
        
        return passCat && passLes && passKey;
    });
    renderCards(filtered);
}

// Các hàm điều khiển giao diện (giữ nguyên)
function setCategory(cat, btn) { currentCat = cat; updateBtn(btn); filterCards(); }
function setLesson(les, btn) { currentLes = les; updateBtn(btn); filterCards(); }
function updateBtn(btn) {
    if(!btn) return;
    var siblings = btn.parentElement.querySelectorAll('.filter-btn');
    siblings.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
}
function toggleQuizMode(btn) {
    isQuiz = !isQuiz;
    btn.style.background = isQuiz ? '#009688' : '';
    btn.style.color = isQuiz ? '#fff' : '';
    filterCards();
}
window.onload = function() { renderCards(data); };
window.onload = function() { renderCards(data); };
</script>
