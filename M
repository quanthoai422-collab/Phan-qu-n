    function setCategory(cat, btn) {
        currentCat = cat;
        if(btn && btn.parentElement) {
            var siblings = btn.parentElement.querySelectorAll('.filter-btn');
            siblings.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }
        filterCards();
    }

    function setLesson(les, btn) {
        currentLes = les;
        if(btn && btn.parentElement) {
            var siblings = btn.parentElement.querySelectorAll('.filter-btn');
            siblings.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }
        filterCards();
    }

    function filterCards() {
        var searchInput = document.getElementById('searchInput');
        var keyword = searchInput ? searchInput.value.toLowerCase().trim() : '';
        
        var filtered = data.filter(i => {
            let passCat = false;
            if (currentCat === 'All' || currentCat === 'all') passCat = true;
            else if (currentCat === 'Từ mới' && i.type === 'new') passCat = true;
            else if (currentCat === 'Luyện dịch' && i.type === 'translate') passCat = true;
            else if (currentCat === 'Luyện tập' && i.type === 'practice') passCat = true;
            else if (i.type === currentCat) passCat = true;

            let passLes = false;
            if (currentLes === 'All' || currentLes === 'all') passLes = true;
            else if (i.lesson === currentLes) passLes = true;

            let passKey = true;
            if (keyword !== '') {
                passKey = ((i.vn && i.vn.toLowerCase().includes(keyword)) || 
                           (i.kr && i.kr.toLowerCase().includes(keyword)));
            }

            return passCat && passLes && passKey;
        });

        renderCards(filtered);
        
        // Đóng menu nếu đang mở trên điện thoại
        var menu = document.getElementById('sidebar');
        var overlay = document.getElementById('overlay');
        if (menu) menu.classList.remove('active');
        if (overlay) overlay.style.display = 'none';
    }

