    // TÍNH NĂNG ĐỌC TIẾNG HÀN BẰNG AI CỦA TRÌNH DUYỆT
    // ==========================================
   function speakKorean(text) {
        if (window.event) window.event.stopPropagation();
        
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
            
            var msg = new SpeechSynthesisUtterance(text);
            
            // Lấy tất cả các giọng nói có sẵn trên thiết bị của Quân
            var voices = window.speechSynthesis.getVoices();
            
            // MẸO: Tìm giọng của Google (thường là giọng nữ, nghe rất tự nhiên)
            // Nếu không có Google, nó sẽ tìm các giọng có ngôn ngữ là ko-KR
            var koreanVoice = voices.find(voice => voice.name.includes('Google') && voice.lang === 'ko-KR');
            
            if (!koreanVoice) {
                koreanVoice = voices.find(voice => voice.lang === 'ko-KR');
            }

            if (koreanVoice) {
                msg.voice = koreanVoice; // Đổi sang giọng vừa tìm được
            }

            msg.lang = 'ko-KR';
            msg.rate = 0.85; // Tốc độ đọc
            msg.pitch = 1.0; // Độ trầm bổng (Quân có thể chỉnh từ 0.1 đến 2.0)
            
            window.speechSynthesis.speak(msg);
        } else {
            alert("Trình duyệt không hỗ trợ phát âm!");
        }
    }

