    function toggleQuizMode(btn) {
        isQuiz = !isQuiz; // Đảo trạng thái Bật/Tắt
        
        if (isQuiz) {
            btn.style.background = '#009688';
            btn.style.color = '#fff';
        } else {
            btn.style.background = '';
            btn.style.color = '#009688';
        }
        
        filterCards(); // Tải lại giao diện thẻ
    }

    function checkInlineAnswer(inputElement, event, correctAnswer) {
        // Chấm điểm thông minh: Bỏ qua dấu câu, khoảng trắng
        let userVal = inputElement.value.trim().toLowerCase().replace(/[\s.,?!~()]/g, '');
        let correctVal = correctAnswer.trim().toLowerCase().replace(/[\s.,?!~()]/g, '');
        
        inputElement.classList.remove('quiz-correct', 'quiz-wrong');
        
        if (userVal === '') return;
        
        if (userVal === correctVal) {
            // Đúng -> Đổi màu Xanh
            inputElement.classList.add('quiz-correct');
            let krText = inputElement.nextElementSibling;
            if(krText) krText.style.display = 'block'; // Hiện kết quả tiếng Hàn cho chắc
        } else if (event.key === 'Enter') {
            // Sai và ấn Enter -> Đổi màu Đỏ và lộ đáp án
            inputElement.classList.add('quiz-wrong');
            let krText = inputElement.nextElementSibling;
            if(krText) krText.style.display = 'block';
        }
    }

